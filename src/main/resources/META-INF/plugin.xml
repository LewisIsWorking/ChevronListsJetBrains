<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.lewisisworking.chevronlists</id>
    <name>Chevron Lists</name>
    <vendor email="lewisisworking@users.noreply.github.com" url="https://github.com/LewisIsWorking">LewisIsWorking</vendor>
    <description><![CDATA[
        <p><b>Chevron Lists</b> brings the chevron-based markdown list manager from VS Code to JetBrains IDEs.</p>
        <p>Use <code>&gt;</code>, <code>&gt;&gt;</code>, <code>&gt;&gt;&gt;</code> blockquote nesting to write sections, items, and sub-items in plain markdown. Get syntax highlighting, duplicate-header warnings, numbered-list integrity checks, and more — all without leaving your editor.</p>
        <p>This is the official JetBrains port of the <a href="https://marketplace.visualstudio.com/items?itemName=lewisisworking.chevron-lists">VS Code extension</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="Markdown"
                   implementationClass="com.lewisisworking.chevronlists.ChevronListsAnnotator"/>
        <enterHandlerDelegate
                   implementation="com.lewisisworking.chevronlists.ChevronEnterHandler"/>
        <applicationConfigurable
                   id="com.lewisisworking.chevronlists.settings"
                   parentId="tools"
                   displayName="Chevron Lists"
                   instance="com.lewisisworking.chevronlists.ChevronListsConfigurable"/>
        <postStartupActivity
                   implementation="com.lewisisworking.chevronlists.ChevronAutoFixStartup"/>
    </extensions>

    <actions>
        <action id="ChevronLists.OpenSettings"
                class="com.lewisisworking.chevronlists.OpenSettingsAction"
                text="CL: Open Settings"
                description="Open the Chevron Lists settings panel">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="ChevronLists.ToggleDone"
                class="com.lewisisworking.chevronlists.ToggleDoneAction"
                text="CL: Toggle Done"
                description="Toggle the [x] done state of the current chevron item">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt D"/>
        </action>
        <action id="ChevronLists.ToggleStar"
                class="com.lewisisworking.chevronlists.ToggleStarAction"
                text="CL: Toggle Star"
                description="Toggle the ⭐ marker on the current chevron item">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="ChevronLists.TogglePin"
                class="com.lewisisworking.chevronlists.TogglePinAction"
                text="CL: Toggle Pin"
                description="Toggle the 📌 marker on the current chevron item">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="ChevronLists.ToggleFlag"
                class="com.lewisisworking.chevronlists.ToggleFlagAction"
                text="CL: Toggle Flag"
                description="Toggle the 🚩 marker on the current chevron item">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="ChevronLists.ToggleNote"
                class="com.lewisisworking.chevronlists.ToggleNoteAction"
                text="CL: Toggle Note"
                description="Toggle the 📝 marker on the current chevron item">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
